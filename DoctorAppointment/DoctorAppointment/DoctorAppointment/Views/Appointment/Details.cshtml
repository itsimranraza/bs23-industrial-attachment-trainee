@model Appointment
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container mt-4">
    <h2>Appointment Details</h2>
    <hr />
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Patient Name</dt>
                <dd class="col-sm-9">@Model.PatientName</dd>

                <dt class="col-sm-3">Date & Time</dt>
                <dd class="col-sm-9">@Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</dd>

                <dt class="col-sm-3">Doctor</dt>
                <dd class="col-sm-9">@(Model.Doctor?.Name ?? "N/A")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>