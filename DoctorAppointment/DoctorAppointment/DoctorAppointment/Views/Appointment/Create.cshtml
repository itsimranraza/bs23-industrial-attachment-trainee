@model AppointmentCreateViewModels
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container mt-4">
    <h2>Book New Appointment</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="PatientName" class="form-label fw-bold">Patient Name</label>
                    <input asp-for="PatientName" class="form-control" />
                    <span asp-validation-for="PatientName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AppointmentDateTime" class="form-label fw-bold">Appointment Date & Time</label>
                    <input asp-for="AppointmentDateTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="AppointmentDateTime" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="DoctorId" class="form-label fw-bold">Select Doctor</label>
                    <select asp-for="DoctorId" class="form-select" asp-items="ViewBag.Doctors">
                        <option value="">Choose a Doctor</option>
                    </select>
                    <span asp-validation-for="DoctorId" class="text-danger small"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Book Appointment</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}