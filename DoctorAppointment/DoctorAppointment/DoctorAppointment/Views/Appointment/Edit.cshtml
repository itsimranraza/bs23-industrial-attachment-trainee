@model DoctorAppointment.ViewModels.AppointmentEditViewModel
@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="container mt-4">
    <h2>Edit Appointment</h2>
    <hr />
    <form asp-action="Edit" method="post">
        <input type ="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="PatientName" class="form-label">Patient Name</label>
            <input asp-for="PatientName" class="form-control" />
            <span asp-validation-for="PatientName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AppointmentDateTime" class="form-label">Date & Time</label>
            <input asp-for="AppointmentDateTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DoctorId" class="form-label">Doctor</label>
            <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select"></select>
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-action="Index" class="btn btn-secondary">Cancle</a>
        </div>
        
    </form>
</div>