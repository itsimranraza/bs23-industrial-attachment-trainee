@model IEnumerable<DoctorAppointment.Entity.Appointment>
@{
    ViewData["Title"] = "Appointment List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Appointment List</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Book New Appointment
        </a>
    </div>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No appointments found. Click "Book New Appointment" to add one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Patient Name</th>
                        <th scope="col">Date & Time</th>
                        <th scope="col">Doctor Name</th>
                        <th scope="col" class="text-center" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.PatientName</td>

                            <td>@item.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>

                            <td>
                                @(item.Doctor != null ? item.Doctor.Name : "N/A")
                            </td>

                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
                                        Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white" title="Details">
                                        Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>