@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container mt-4">
    <h2>Delete Appointment</h2>
    <hr />
    <div class="alert alert-danger">
        <p>Are you sure you want to delete this appointment?</p>
        <p><strong>Patient:</strong> @Model.PatientName</p>
        <p><strong>Date & Time:</strong> @Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</p>
        <p><strong>Doctor:</strong> @(Model.Doctor?.Name ?? "N/A")</p>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>