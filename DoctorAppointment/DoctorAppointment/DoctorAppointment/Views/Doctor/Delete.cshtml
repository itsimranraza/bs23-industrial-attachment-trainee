@model Doctor
@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Delete Doctor
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        Are you sure you want to delete this doctor?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Doctor Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Specialization</dt>
                        <dd class="col-sm-8">@Model.Specialization</dd>

                        <dt class="col-sm-4">Total Appointments</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">
                                @(Model.Appointments?.Count ?? 0)
                            </span>
                        </dd>
                    </dl>

                    @if (Model.Appointments != null && Model.Appointments.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-circle"></i>
                            This doctor has <strong>@Model.Appointments.Count</strong>
                            appointment(s). Deleting will also remove all appointments!
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Yes, Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>