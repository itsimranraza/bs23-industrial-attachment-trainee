@model List<Doctor>
@{
    ViewData["Title"] = "Doctors List";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h1>Doctors Directory</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Doctor</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 35%">Name</th>
                    <th scope="col" style="width: 35%">Specialization</th>
                    <th scope="col" style="width: 35%">Details</th>
                    
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var doctor in Model)
                    {
                        <tr>
                            <td>@(doctor.Name ?? "N/A")</td>
                            <td>@(doctor.Specialization ?? "General Medicine")</td>
                            <td>
                                <a asp-controller="Doctor" asp-action="Details" class="btn btn-primary" asp-route-id="@doctor.Id" >View</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No doctors found in the system.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>